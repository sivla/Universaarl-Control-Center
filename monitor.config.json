{
  "schemaVersion": 1,
  "name": "Universaarl Kontrollzentrum",
  "reportDirectory": "reports",
  "validationTimeoutSeconds": 600,
  "projects": [
    {
      "id": "blueprint",
      "name": "Universaarl BC Blueprint V2",
      "pathAlias": "<BLUEPRINT_ROOT>",
      "defaultPath": "C:\\Users\\kkali\\Documents\\Universaarl Projekt BC Basic",
      "pathEnvironmentVariable": "UNIVERSAARL_BLUEPRINT_PATH",
      "reviewFile": "REVIEW.md",
      "requiredNpmScript": "test",
      "validationArguments": ["test"],
      "germanCheck": {
        "npmScript": "test:german",
        "resultSchemaVersion": 1
      },
      "allowedVersionedMedia": [
        {
          "path": "artifacts/walkthrough/generated/UABC-WT-ENV-001/walkthrough.webm",
          "maxBytes": 1048576,
          "mode": "100644"
        }
      ],
      "maxActiveChanges": 1,
      "publish": {
        "enabled": true,
        "remote": "origin",
        "branch": "codex/universaarl-projekt",
        "expectedPushUrl": "https://github.com/sivla/FiBu.git"
      }
    },
    {
      "id": "project-twin",
      "name": "Universaarl Project Twin",
      "pathAlias": "<TWIN_ROOT>",
      "defaultPath": "C:\\Users\\kkali\\Documents\\Universaarl-Project-Twin",
      "pathEnvironmentVariable": "UNIVERSAARL_TWIN_PATH",
      "reviewFile": "REVIEW.md",
      "requiredNpmScript": "check",
      "validationArguments": ["run", "check"],
      "germanCheck": {
        "npmScript": "test:german",
        "resultSchemaVersion": 1
      },
      "allowedVersionedMedia": [],
      "maxActiveChanges": 1,
      "publish": {
        "enabled": true,
        "remote": "origin",
        "branch": "codex/universaarl-projekt-twin",
        "expectedPushUrl": "https://github.com/sivla/FiBu.git"
      }
    }
  ],
  "verificationSources": {
    "bcprojectos": {
      "verificationOnly": true,
      "technicalProjectName": "BCProjectOS",
      "expectedProduct": {
        "name": "Spectra",
        "productId": "spectra"
      },
      "pathAlias": "<BCPROJECTOS_ROOT>",
      "defaultPath": "C:\\Users\\kkali\\Documents\\BC Project OS",
      "pathEnvironmentVariable": "UNIVERSAARL_BCPROJECTOS_PATH",
      "remote": "origin",
      "canonicalRemoteUrl": "https://github.com/sivla/BCProjectOS.git"
    }
  },
  "relationships": [
    {
      "id": "blueprint-binds-spectra",
      "consumerProjectId": "blueprint",
      "providerVerificationSourceId": "bcprojectos",
      "contractType": "versioned-product-release",
      "productId": "spectra",
      "contractMarker": "BOUND_BCPROJECTOS_RELEASE"
    },
    {
      "id": "twin-reads-blueprint",
      "consumerProjectId": "project-twin",
      "providerProjectId": "blueprint",
      "contractType": "portable-snapshot-release",
      "pointerPath": "exports/project-data/v1/snapshots/current.json",
      "contractMarker": "uabc-portable-snapshot-current-v1"
    }
  ]
}
