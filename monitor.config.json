{
  "schemaVersion": 1,
  "name": "Universaarl Kontrollzentrum",
  "reportDirectory": "reports",
  "validationTimeoutSeconds": 240,
  "projects": [
    {
      "id": "blueprint",
      "name": "Universaarl BC Blueprint V2",
      "pathAlias": "<BLUEPRINT_ROOT>",
      "defaultPath": "C:\\Users\\kkali\\Documents\\Universaarl Projekt BC Basic",
      "pathEnvironmentVariable": "UNIVERSAARL_BLUEPRINT_PATH",
      "reviewFile": "REVIEW.md",
      "requiredNpmScript": "test",
      "validationArguments": ["test"],
      "germanCheck": {
        "npmScript": "test:german",
        "resultSchemaVersion": 1
      },
      "allowedVersionedMedia": [
        {
          "path": "artifacts/walkthrough/generated/UABC-WT-ENV-001/walkthrough.webm",
          "maxBytes": 1048576,
          "mode": "100644"
        }
      ],
      "maxActiveChanges": 1,
      "publish": {
        "enabled": true,
        "remote": "origin",
        "branch": "codex/universaarl-projekt",
        "expectedPushUrl": "https://github.com/sivla/FiBu.git"
      }
    },
    {
      "id": "project-twin",
      "name": "Universaarl Project Twin",
      "pathAlias": "<TWIN_ROOT>",
      "defaultPath": "C:\\Users\\kkali\\Documents\\Universaarl-Project-Twin",
      "pathEnvironmentVariable": "UNIVERSAARL_TWIN_PATH",
      "reviewFile": "REVIEW.md",
      "requiredNpmScript": "check",
      "validationArguments": ["run", "check"],
      "germanCheck": {
        "npmScript": "test:german",
        "resultSchemaVersion": 1
      },
      "allowedVersionedMedia": [],
      "maxActiveChanges": 1,
      "publish": {
        "enabled": true,
        "remote": "origin",
        "branch": "codex/universaarl-projekt-twin",
        "expectedPushUrl": "https://github.com/sivla/FiBu.git"
      }
    }
  ],
  "relationships": [
    {
      "id": "twin-reads-blueprint",
      "consumerProjectId": "project-twin",
      "providerProjectId": "blueprint",
      "environmentVariable": "UABC_SOURCE_REPO",
      "contractMarker": "UABC_SOURCE_REPO"
    }
  ]
}
